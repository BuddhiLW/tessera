{:paths ["src"]
 ;; desargues supplies the generic parts: desargues.wallpaper.loop (seamless phase),
 ;; .render (field rasteriser, scene engines, video encoders), .post (bloom, dof,
 ;; chroma ...), .girih (Hankin star patterns, beads), .curves (space-filling
 ;; curves), .luxcore (LuxCore scene engine), .preview (live mpv window).
 ;; See README for a local override.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        thi.ng/color {:mvn/version "1.5.1"}
        io.github.mentat-collective/desargues {:git/url "https://github.com/mentat-collective/desargues.git"
                                               :git/sha "d5956a7dbf84e4e5b116097c67655a64c68fb951"}}
 :aliases
 {;; clojure -M:render --list | --preview | --only id,id --format mp4|webm|gif|png --size 1920x1080
  :render {:main-opts ["-m" "tessera.main"]}
  ;; clojure -M:uw [--only id,id]: native 2560x1080 (fosfora HDMI-0) into out/uw/
  :uw {:main-opts ["-m" "tessera.main" "--uw"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
