{:paths ["src"]
 ;; desargues supplies the generic parts: desargues.wallpaper.loop (seamless phase),
 ;; desargues.wallpaper.render (field rasteriser, scene engines, video encoders),
 ;; desargues.wallpaper.girih (Hankin star patterns) and desargues.wallpaper.luxcore
 ;; (the LuxCore scene engine). See README for a local override.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.mentat-collective/desargues {:git/url "https://github.com/mentat-collective/desargues.git"
                                               :git/sha "defd4d7e1eba6cd437d31b3b2b027b099aeb4bc3"}}
 :aliases
 {;; clojure -M:render --list | --preview | --only id,id --format mp4|webm|gif|png --size 1920x1080
  :render {:main-opts ["-m" "tessera.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
